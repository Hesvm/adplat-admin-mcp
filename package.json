{
  "name": "adplat-admin-mcp",
  "version": "1.3.0",
  "description": "Comprehensive Model Context Protocol (MCP) Server for Adplat.space Admin with zero-touch auto-login, browser loopback, permanent API keys, headless OTP, and 120 management tools.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "adplat-admin-mcp": "./bin/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "login": "node bin/cli.js login",
    "login:browser": "node bin/cli.js login --browser",
    "login:otp": "node bin/cli.js login --otp",
    "status": "node bin/cli.js status",
    "test": "node src/test-connection.js",
    "audit": "node scripts/audit-tools.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "adplat",
    "dastyar",
    "advertising",
    "serp",
    "admin-mcp",
    "antigravity",
    "claude-desktop",
    "cursor"
  ],
  "author": "Hesam Mousavi (Hesvm)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axios": "^1.8.1",
    "dotenv": "^16.4.7",
    "form-data": "^4.0.2",
    "zod": "^3.24.2"
  }
}
